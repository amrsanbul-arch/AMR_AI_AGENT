APP_ENV=development
WEB_ORIGIN=http://localhost:3000

# Single-owner API protection. Generate both values locally; never commit real secrets.
# AMR_OWNER_PASSWORD_HASH=
# AMR_SESSION_SECRET=
# Generate an env-safe password hash (prompts locally; password itself is not printed):
# PYTHONPATH=api uv run python -c 'from getpass import getpass; from app.owner_auth import hash_owner_password; print(hash_owner_password(getpass("Owner password (14+ chars): ")))'
# Generate a random session secret locally:
# python -c 'import secrets; print(secrets.token_urlsafe(48))'

# Official Instagram Login (Meta developer app). Leave blank until set up by the account owner.
# Never commit real values or expose META_APP_SECRET to the browser.
# META_APP_ID=
# META_APP_SECRET=
# META_REDIRECT_URI=http://localhost:8000/api/instagram/callback
# Official versioned Graph API requests; keep current with Meta documentation.
# META_GRAPH_API_VERSION=v27.0
# Generate a private Fernet key locally: uv run python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())'
# INSTAGRAM_TOKEN_ENCRYPTION_KEY=
# Optional local SQLite path; the directory/database is excluded from Git.
# INSTAGRAM_TOKEN_DB_PATH=data/instagram.sqlite3
